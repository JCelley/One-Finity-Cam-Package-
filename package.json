{
  "name": "onefinity-cam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser CAD/CAM for the Onefinity CNC with a MASSO Touch controller.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:update-golden": "vitest run -u",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/lobster": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@fontsource/rye": "5.3.0",
    "clipper2-ts": "2.0.1",
    "opentype.js": "1.3.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.187.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
